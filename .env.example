# Copy to .env (gitignored) and fill in for deploy/tailscale-pfsense-lan.sh
TAILSCALE_API_KEY=tskey-api-REPLACE_ME
TAILSCALE_TAILNET=tailf1ad0d.ts.net

# Lab LAN (pfSense advertises this; PVE nodes share the segment)
LAN_CIDR=172.16.0.0/16
LAN_TEST_IP=172.16.0.101
MAIN_PVE_LAN_IP=172.16.0.101

# Optional: main node MagicDNS name (no trailing dot) for direct tailnet UI verify
# MAIN_PVE_TAILSCALE_NAME=pvenode-001.tailf1ad0d.ts.net
