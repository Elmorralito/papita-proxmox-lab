# Papita lab — chrony in unprivileged Debian LXC (deploy/setup/misc/lxc/papita-chrony-lxc.sh)
# Copy to chrony-lxc.env on the CT (gitignored) or export before running.
#
# Space-separated NTP pools/hostnames (same style as setup-pve-node.sh step 6).
PAPITA_NTP_SERVERS=pool.ntp.org

# Set to 1 to disable chrony entirely and rely on the Proxmox host clock (recommended for most CTs).
# PAPITA_CHRONY_LXC_DISABLE=1
