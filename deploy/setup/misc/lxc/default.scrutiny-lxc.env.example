# Papita Scrutiny collector LXC (privileged; host /dev bind for SMART).
# Copy to /root/scrutiny-lxc.env on the CT, or export before running papita-scrutiny-collector-lxc.sh
#
# Hub must match TrueNAS Scrutiny app version (see docs/TIPSNTRICKS.md § Scrutiny).
export PAPITA_SCRUTINY_HUB_URL="http://172.16.0.100:31054"
export PAPITA_SCRUTINY_VERSION="0.9.2"
# Unique per node — defaults to container hostname (e.g. scrutiny-pvenode-001)
export PAPITA_SCRUTINY_HOST_ID=""
# systemd timer interval after boot / last run (e.g. 30min, 1h, 12h)
export PAPITA_SCRUTINY_INTERVAL="30min"
