# Papita lab — Uptime Kuma bootstrap (deploy/setup/misc/monitoring/papita-uptime-kuma-bootstrap.py)
# Copy to uptime-kuma.env on the PVE node (gitignored) or export before running bootstrap.
#
# Kuma instance (LXC 1004 on pvenode-001 by default)
UPTIME_KUMA_URL=http://172.16.1.12:3001
UPTIME_KUMA_USERNAME=admin
# Leave empty on first run to auto-generate; saved to uptime-kuma.credentials on the node.
UPTIME_KUMA_PASSWORD=

# Telegram (optional — skip notification setup when unset)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Lab targets (override if your layout differs)
PFSENSE_IP=172.16.0.1
TRUENAS_IP=172.16.0.100
PVE_NODE_IPS=172.16.0.101,172.16.0.102,172.16.0.103
