# Proxmox guest firewall for k8s-monitor LXC (VMID 231).
# Apply with papita-k8s-monitor-ct-firewall.sh on a cluster member.
# Grafana (:3000) moved to the QDevice Pi; it reaches Prometheus via the LAN :9090 rule.
[OPTIONS]
enable: 1

[RULES]
IN ACCEPT -source 172.16.0.0/16 -p tcp -dport 9090 -log nolog
IN ACCEPT -source 172.16.0.0/16 -p tcp -dport 9093 -log nolog
IN ACCEPT -source 172.16.0.0/16 -p tcp -dport 22 -log nolog
