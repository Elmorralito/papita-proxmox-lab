      "datasource": {
        "type": "prometheus",
        "uid": ""
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_systemd_unit_state{job=\"pve-nodes\",state=\"failed\"}",
          "legendFormat": "{{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": ""
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "spanNulls": true
          }
        },
        "overrides": []
