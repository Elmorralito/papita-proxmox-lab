      "id": 201,
      "type": "stat",
      "title": "Disks monitored",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 50
      },
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "papita-scrutiny"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "papita-scrutiny"
          },
          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "backend",
          "url": "/api/summary",
          "url_options": {
            "method": "GET",
            "data": ""
          },
          "root_selector": "$filter($each(data.summary, function($v, $k) {\n  {\n    \"wwn\": $k,\n    \"device\": $v.device.device_name,\n    \"model\": $v.device.model_name,\n    \"serial\": $v.device.serial_number,\n    \"protocol\": $v.device.device_protocol,\n    \"capacity\": $v.device.capacity,\n    \"status\": $v.device.device_status,\n    \"failed\": $v.device.device_status > 0 ? 1 : 0,\n    \"archived\": $v.device.archived = true,\n    \"temp\": $v.smart.temp,\n    \"power_on_hours\": $v.smart.power_on_hours,\n    \"last_seen\": $v.smart.collector_date\n  }\n}), function($r) { $r.archived = false })",
          "columns": [
            {
              "selector": "device",
              "text": "Device",
              "type": "string"
            },
            {
              "selector": "model",
              "text": "Model",
              "type": "string"
            },
            {
              "selector": "serial",
              "text": "Serial",
              "type": "string"
            },
            {
              "selector": "protocol",
              "text": "Protocol",
              "type": "string"
            },
            {
              "selector": "capacity",
              "text": "Capacity",
              "type": "number"
            },
            {
              "selector": "status",
              "text": "Status",
              "type": "number"
            },
            {
              "selector": "failed",
              "text": "failed",
              "type": "number"
            },
            {
              "selector": "temp",
              "text": "Temp",
              "type": "number"
            },
            {
              "selector": "power_on_hours",
              "text": "Power-on",
              "type": "number"
            },
            {
              "selector": "last_seen",
              "text": "Last collected",
              "type": "timestamp"
            },
            {
              "selector": "wwn",
              "text": "WWN",
              "type": "string"
            }
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "count"
          ],
          "fields": "/^failed$/"
        },
        "colorMode": "value"
      }
    },
