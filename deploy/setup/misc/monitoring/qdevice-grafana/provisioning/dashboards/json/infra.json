{
  "uid": "papita-infra",
  "title": "Papita infra (PVE + TrueNAS)",
  "tags": [
    "papita",
    "pve",
    "truenas",
    "scrutiny",
    "infra"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "editable": true,
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "PVE-only dashboard",
      "type": "link",
      "url": "/d/papita-pve/papita-proxmox-ve-cluster",
      "targetBlank": false
    },
    {
      "title": "Scrutiny-only dashboard",
      "type": "link",
      "url": "/d/papita-scrutiny/papita-truenas-disks-scrutiny",
      "targetBlank": false
    },
    {
      "title": "Scrutiny WebUI",
      "type": "link",
      "url": "http://172.16.0.236:31054",
      "targetBlank": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Proxmox VE cluster",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 101,
      "type": "stat",
      "title": "PVE nodes up",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": ""
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up{job=\"pve-nodes\"})",
          "legendFormat": "{{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": ""
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      }
    },
    {
      "id": 102,
      "type": "stat",
      "title": "CPU busy % (avg)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": ""
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * avg(1 - rate(node_cpu_seconds_total{job=\"pve-nodes\",mode=\"idle\"}[5m]))",
          "legendFormat": "{{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": ""
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      }
    },
    {
      "id": 103,
      "type": "timeseries",
      "title": "CPU busy % by node",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": ""
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{job=\"pve-nodes\",mode=\"idle\"}[5m])))",
          "legendFormat": "{{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": ""
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "spanNulls": true
          },
          "unit": "percent"
        },
        "overrides": []
      }
    },
    {
      "id": 104,
      "type": "timeseries",
      "title": "Load average 5m",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": ""
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_load5{job=\"pve-nodes\"}",
          "legendFormat": "{{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": ""
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "spanNulls": true
          }
        },
        "overrides": []
      }
    },
    {
      "id": 105,
      "type": "timeseries",
      "title": "Memory used",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 17
      },
      "datasource": {
        "type": "prometheus",
        "uid": ""
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_memory_MemTotal_bytes{job=\"pve-nodes\"} - node_memory_MemAvailable_bytes{job=\"pve-nodes\"}",
          "legendFormat": "{{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": ""
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "spanNulls": true
          },
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "id": 106,
      "type": "timeseries",
      "title": "Memory available",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 17
      },
      "datasource": {
        "type": "prometheus",
        "uid": ""
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_memory_MemAvailable_bytes{job=\"pve-nodes\"}",
          "legendFormat": "{{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": ""
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "spanNulls": true
          },
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "id": 107,
      "type": "timeseries",
      "title": "Root filesystem used %",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 25
      },
      "datasource": {
        "type": "prometheus",
        "uid": ""
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - node_filesystem_avail_bytes{job=\"pve-nodes\",mountpoint=\"/\"} / node_filesystem_size_bytes{job=\"pve-nodes\",mountpoint=\"/\"})",
          "legendFormat": "{{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": ""
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "spanNulls": true
          },
          "unit": "percent"
        },
        "overrides": []
      }
    },
    {
      "id": 108,
      "type": "timeseries",
      "title": "Disk IO (read+write)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 25
      },
      "datasource": {
        "type": "prometheus",
        "uid": ""
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance) (rate(node_disk_read_bytes_total{job=\"pve-nodes\"}[5m]) + rate(node_disk_written_bytes_total{job=\"pve-nodes\"}[5m]))",
          "legendFormat": "{{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": ""
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "spanNulls": true
          },
          "unit": "Bps"
        },
        "overrides": []
      }
    },
    {
      "id": 109,
      "type": "timeseries",
      "title": "Network receive",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 33
      },
      "datasource": {
        "type": "prometheus",
        "uid": ""
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance) (rate(node_network_receive_bytes_total{job=\"pve-nodes\",device!~\"lo|veth.*|fwbr.*|fwln.*|tap.*|vmbr.*dummy\"}[5m]))",
          "legendFormat": "{{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": ""
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "spanNulls": true
          },
          "unit": "Bps"
        },
        "overrides": []
      }
    },
