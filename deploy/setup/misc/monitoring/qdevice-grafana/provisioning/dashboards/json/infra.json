      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 33
      },
      "datasource": {
        "type": "prometheus",
        "uid": ""
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance) (rate(node_network_transmit_bytes_total{job=\"pve-nodes\",device!~\"lo|veth.*|fwbr.*|fwln.*|tap.*\"}[5m]))",
