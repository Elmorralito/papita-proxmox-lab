# Copied to /etc/grafana/papita.env on the QDevice Pi (never commit the real file).
# grafana-server reads it via the papita systemd drop-in. Grafana only honors GF_* variables.
# The admin password is applied on the FIRST start only; later use: grafana cli admin reset-admin-password
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=
