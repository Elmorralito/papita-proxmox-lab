# Papita lab: TrueNAS NFS shared storage for Proxmox HA (source from papita-cluster-quorum-ha.sh).
# Server is the NAS LAN IP (NFS bindip). Nested misc datasets need their own exports.

TRUENAS_NFS_SERVER=172.16.0.100
TRUENAS_NFS_EXPORT=/mnt/main_data_storage
PVE_NFS_STORAGE_ID=truenas-nfs-main
PVE_NFS_CONTENT=images,rootdir
PVE_NFS_OPTIONS=vers=4.1,hard,nconnect=4

# id|export|content  (applied on all cluster nodes; omit nodes= for datacenter-wide)
PVE_NFS_SHARE_TABLE="
truenas-nfs-main|/mnt/main_data_storage|images,rootdir
truenas-nfs-misc-images|/mnt/misc_data_storage/vm-images|iso
truenas-nfs-misc-templates|/mnt/misc_data_storage/ct-templates|vztmpl
truenas-nfs-misc-oci|/mnt/misc_data_storage/oci-images|import
truenas-nfs-misc-logs|/mnt/misc_data_storage/logs|backup
"

HA_GROUP_NAME=papita-ha
# Live cluster members (pvecm-oldtimers). pve-003 removed from cluster.
HA_NODES=pve-001,pve-002,pve-004
# Keep 0: current guests (pfSense 100, Fedora 101) use local-lvm and must not be HA-enrolled.
HA_AUTO_ENROLL_NFS_GUESTS=0
