# Papita lab: TrueNAS NFS shared storage for Proxmox HA (source from papita-cluster-quorum-ha.sh).
# Edit TRUENAS_NFS_EXPORT to match your TrueNAS dataset path (Sharing → NFS on 172.16.0.100).

TRUENAS_NFS_SERVER=172.16.0.100
TRUENAS_NFS_EXPORT=/mnt/pve-cluster-oldtimers-ha-storage/pve-nfs
PVE_NFS_STORAGE_ID=truenas-nfs
PVE_NFS_CONTENT=images,rootdir
PVE_NFS_OPTIONS=vers=4.1,hard,nconnect=4
HA_GROUP_NAME=papita-ha
# Comma-separated HA failover pool (exclude infra nodes like pvenode-001).
HA_NODES=pvenode-002,pvenode-003,pvenode-004
# Set to 1 to enroll NFS-backed guests (no local-only disks) into ha-manager.
HA_AUTO_ENROLL_NFS_GUESTS=0
