# Papita lab: TrueNAS NFS shared storage for Proxmox HA (source from papita-cluster-quorum-ha.sh).
# Server is the NAS LAN IP (NFS bindip). Nested datasets need their own exports.
#
# Topology: single pool main_data_storage (mirror-0 4TB + mirror-1 2TB striped).
# Former misc_data_storage was destroyed and its disks added as mirror-1.

TRUENAS_NFS_SERVER=172.16.0.100
TRUENAS_NFS_EXPORT=/mnt/main_data_storage
PVE_NFS_STORAGE_ID=truenas-nfs-main
PVE_NFS_CONTENT=images,rootdir
PVE_NFS_OPTIONS=vers=4.1,hard,nconnect=4

# id|export|content  (applied on all cluster nodes; omit nodes= for datacenter-wide)
PVE_NFS_SHARE_TABLE="
truenas-nfs-main|/mnt/main_data_storage|images,rootdir
truenas-nfs-media|/mnt/main_data_storage/ct-templates|iso,vztmpl,import,snippets
truenas-nfs-logs|/mnt/main_data_storage/logs|backup
"

HA_GROUP_NAME=papita-ha
# Live cluster members (pvecm-oldtimers).
HA_NODES=pve-001,pve-003,pve-002,pve-004
# Keep 0: current guests (pfSense 100, Fedora-Testing 101) use local-lvm and must not be HA-enrolled.
HA_AUTO_ENROLL_NFS_GUESTS=0
# Datacenter ha.shutdown_policy. freeze: HA guests are not recovered elsewhere on node shutdown/reboot.
# Required by the MCP power tools (docs/MCP_POWER_PLAN.md).
HA_SHUTDOWN_POLICY=freeze
