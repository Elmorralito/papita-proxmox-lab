# Auth / surface hardening (P0)
LLAMA_API_KEY_FILE=/etc/llama/secrets/llama.api-keys
LLAMA_CORS_ORIGINS=localhost
LLAMA_WEBUI=0
# VRAM ceiling (GTX 1050 4GB): pooling=none allocates a 673 MiB per-token output buffer;
# ngl=14 @ ctx=1024, ubatch=1024, pooling=none ≈ 3875 MiB / 4096 MiB VRAM.
# Kev must stay on CPU (KEV_DEVICE=cpu) — no CUDA headroom.
