#!/usr/bin/env bash
# Deprecated: use aictl. Forwards to aictl with target=qwen where applicable.
set -euo pipefail
cmd=${1:-}
case "$cmd" in
  ""|-h|--help)
    echo "deprecated: use aictl. Example: aictl status qwen"
    exec /usr/local/sbin/aictl -h
    ;;
  bootstrap) systemctl start llama-bootstrap.service ;;
  env) cat /home/llama/bin/llama-env ;;
  enable)
    systemctl enable llama-bootstrap.service llama-cpu-performance.service llama-gpu-perf.service llama-server.service
    echo 'enabled at boot'
    ;;
  disable)
    systemctl disable llama-server.service
    echo 'llama-server disabled at boot'
    ;;
  health)
    curl -fsS --max-time 5 http://127.0.0.1:8080/health; echo
    ;;
  *)
    exec /usr/local/sbin/aictl "$cmd" qwen
    ;;
esac
