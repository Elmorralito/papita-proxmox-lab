[Unit]
Description=Post-startup procedure for pve node
# Must be ordered BEFORE pve-guests: without quorum its "pvesh startall" blocks
# on "waiting for quorum ...", so ordering this unit After=pve-manager.service
# left it queued forever and the isolated-node recovery could never run.
After=network-online.target corosync.service pve-cluster.service pvedaemon.service pvestatd.service
Wants=network-online.target
Before=pve-guests.service

[Service]
ExecStart=/usr/local/bin/post-startup-proc.sh
Type=oneshot
RemainAfterExit=true
# Must exceed QUORUM_WAIT_SEC plus the peer probe and guest start; the default
# 90s start timeout would kill the script mid-wait.
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
