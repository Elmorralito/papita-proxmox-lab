# openwrt-mcp settings (OPENWRT_*). Never commit real values.

# Router (Tailscale IP of openwrt-pi; LAN IP is used for LAN-vantage probes)
OPENWRT_ROUTER_ID=openwrt-pi
OPENWRT_HOST=100.78.68.87
OPENWRT_LAN_HOST=172.16.0.1

# DEDICATED restricted agent key (forced command). Do NOT use the root admin key (id_ed25519_NASGW).
OPENWRT_SSH_KEY_PATH=~/.ssh/id_ed25519_openwrt_mcp
# known_hosts containing ONLY the router host key (see README: ssh-keyscan -t ed25519 100.78.68.87)
OPENWRT_KNOWN_HOSTS_PATH=~/.config/openwrt-mcp/known_hosts

# Local state (SQLite + audit chain) and approver keys
OPENWRT_STATE_DIR=~/.local/state/openwrt-mcp
OPENWRT_APPROVER_KEY_PATH=~/.config/openwrt-mcp/approver.key
OPENWRT_APPROVER_PUBKEY_PATH=~/.config/openwrt-mcp/approver.pub

# Policy timing
OPENWRT_PLAN_TTL_SEC=900
OPENWRT_VERIFY_DEADLINE_SEC=120

# LAN vantage for verification probes (PVE main node); empty disables
OPENWRT_PROBE_HOST=172.16.0.101
OPENWRT_PROBE_USER=root
# OPENWRT_PROBE_KEY_PATH=~/.ssh/id_ed25519_NASGW
# OPENWRT_PROBE_KNOWN_HOSTS_PATH=~/.ssh/known_hosts

OPENWRT_LOG_LEVEL=INFO
