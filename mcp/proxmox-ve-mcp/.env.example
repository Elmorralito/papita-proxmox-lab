# Proxmox VE MCP — environment variables (optional if using Cursor mcp.json)

# Cursor: supply the same keys in mcp.json "env" — a .env file is NOT required.

# Required: any online cluster member (Tailscale MagicDNS or LAN IP)
PVE_HOST=pvenode-001.your-tailnet.ts.net
PVE_PORT=8006

# Auth: either combined token...
# PVE_API_TOKEN=mcp-agent@pam!mcp-cursor=YOUR_SECRET_HERE

# ...or split fields (recommended for Cursor mcp.json env block)
PVE_USER=mcp-agent@pam
PVE_TOKEN_ID=mcp-cursor
PVE_TOKEN_SECRET=YOUR_SECRET_HERE

# TLS: true after setup-pve-node.sh step 17 (Tailscale cert on :8006)
# Set false only for default self-signed cert during initial lab setup
PVE_VERIFY_SSL=true
PVE_LOG_LEVEL=INFO

# Integration tests only: poetry run pytest -k integration with live cluster
# PVE_INTEGRATION=1
