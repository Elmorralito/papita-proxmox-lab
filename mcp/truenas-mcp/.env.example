TRUENAS_HOST=172.16.0.236
TRUENAS_PORT=443
TRUENAS_API_KEY=replace-me
# Default in code is true. Use false only for self-signed lab certs on a trusted LAN.
TRUENAS_VERIFY_SSL=false
TRUENAS_WS_PATH=/websocket
TRUENAS_WS_PING_INTERVAL_SEC=30
TRUENAS_LAB_HA_POOL_NAME=main_data_storage
TRUENAS_LAB_NFS_EXPORT=/mnt/main_data_storage
TRUENAS_LAB_SCRUTINY_APP_NAME=scrutiny
# TRUENAS_LAB_CONFIG_FILE=/path/to/deploy/setup/misc/cluster/default.truenas.nfs.env
TRUENAS_LOG_LEVEL=INFO
