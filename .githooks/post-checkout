#!/usr/bin/env bash
# After branch checkout, refresh Cursor MCP configs when mcp.json.example files changed.
set -euo pipefail

# Skip when only checking out files within the working tree (not a branch switch).
if [[ "${3:-1}" == "0" ]]; then
    exit 0
fi

ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
[[ -f "${ROOT}/deploy/mcp.sh" ]] || exit 0

cd "${ROOT}"
./deploy/mcp.sh cursor-sync --all-targets --if-changed --enable-agent 2>/dev/null || true
